<?xml version="1.0" encoding="utf-8"?>
<!-- The Android app: one full-screen, landscape window that runs the web game.
     Built by tools/build-apk.mjs; see GAME.md, "On Android as an app". -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.munderdifflin.office">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

    <!-- To reach Ollama on the laptop, and to buzz when someone is dropped. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Cleartext: Ollama on the home network speaks plain http. -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Game"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true"
        android:allowBackup="true">

        <!-- Never recreated on rotation or resize, or the game would restart. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|fontScale"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
